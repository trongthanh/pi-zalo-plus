{
  "$schema": "https://json.schemastore.org/package",
  "name": "pi-zalo-plus",
  "version": "1.0.0",
  "description": "Full Zalo control of pi coding agent — commands, interactive UI, model/session management, file transfer, and real-time streaming output, all from Zalo",
  "keywords": [
    "coding-agent",
    "pi-extension",
    "pi-package",
    "remote-control",
    "zalo"
  ],
  "license": "MIT",
  "author": "Thanh Tran (https://thanh.im)",
  "repository": {
    "type": "git",
    "url": "https://github.com/trongthanh/pi-zalo-plus"
  },
  "files": [
    "index.ts",
    "lib/**/*.ts",
    "!lib/__tests__/",
    "pi-host.d.ts"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.76.0 <0.82.0",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/trongthanh/pi-zalo-plus/main/docs/img/pi-zalo-plus.png"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.6": true
  }
}
